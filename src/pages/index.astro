---
const title = 'Intelligent Land Record System';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Intelligent Land Record Digitization and Validation System" />
    <title>{title}</title>
  </head>

  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Home">
          <span class="brand-mark">LR</span>
          <span>
            <strong>Land Records</strong>
            <small>Digitization & Validation</small>
          </span>
        </a>
        <span class="status"><i></i> System ready</span>
      </header>

      <section class="hero">
        <div class="eyebrow">INTELLIGENT LAND RECORD SYSTEM</div>
        <h1>Turn legacy land records into <em>structured data.</em></h1>
        <p>Upload a scanned land record to begin OCR, extraction and validation.</p>
      </section>

      <section class="workspace" aria-label="Document upload">
        <div class="upload-card" id="dropZone">
          <input id="fileInput" type="file" accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff" hidden />
          <div class="upload-icon" aria-hidden="true">↑</div>
          <h2>Upload a land record</h2>
          <p>Drop a PDF or image here, or choose a file from your device.</p>
          <button class="primary" id="chooseButton" type="button">Choose document</button>
          <span class="formats">PDF · PNG · JPG · TIFF</span>
        </div>

        <div class="info-card">
          <div class="card-heading">
            <span>PROCESS</span>
            <span class="phase">Phase 01</span>
          </div>
          <ol>
            <li class="active"><b>01</b><span>Upload document<small>Select a source record</small></span></li>
            <li><b>02</b><span>OCR & extraction<small>Text, layout and fields</small></span></li>
            <li><b>03</b><span>Validation<small>Rules and confidence</small></span></li>
            <li><b>04</b><span>Verification<small>Review uncertain fields</small></span></li>
          </ol>
        </div>
      </section>

      <section class="selected" id="selected" hidden>
        <div class="file-symbol">PDF</div>
        <div class="file-details">
          <strong id="fileName">document.pdf</strong>
          <span id="fileSize">0 KB</span>
        </div>
        <button class="ghost" id="removeButton" type="button">Remove</button>
        <button class="primary small" id="processButton" type="button">Process document</button>
      </section>

      <section class="processing" id="processing" hidden>
        <div class="processing-head">
          <span id="processText">Preparing document…</span>
          <strong id="processPercent">0%</strong>
        </div>
        <div class="progress"><span id="progressBar"></span></div>
        <p>Processing UI is ready. The Rust OCR backend will be connected in the next step.</p>
      </section>

      <footer>
        <span>Open-source pipeline · Rust + Tesseract</span>
        <span>Built for multilingual land-record digitization</span>
      </footer>
    </main>

    <script>
      const input = document.querySelector('#fileInput');
      const dropZone = document.querySelector('#dropZone');
      const chooseButton = document.querySelector('#chooseButton');
      const selected = document.querySelector('#selected');
      const fileName = document.querySelector('#fileName');
      const fileSize = document.querySelector('#fileSize');
      const removeButton = document.querySelector('#removeButton');
      const processButton = document.querySelector('#processButton');
      const processing = document.querySelector('#processing');
      const processText = document.querySelector('#processText');
      const processPercent = document.querySelector('#processPercent');
      const progressBar = document.querySelector('#progressBar');
      let file = null;
      let timer = null;

      const formatSize = (bytes) => {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      };

      function selectFile(nextFile) {
        if (!nextFile) return;
        const allowed = /\.(pdf|png|jpe?g|tiff?)$/i.test(nextFile.name);
        if (!allowed) return;
        file = nextFile;
        fileName.textContent = file.name;
        fileSize.textContent = formatSize(file.size);
        selected.hidden = false;
        processing.hidden = true;
      }

      chooseButton.addEventListener('click', () => input.click());
      input.addEventListener('change', () => selectFile(input.files?.[0]));

      ['dragenter', 'dragover'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.add('dragging');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropZone.addEventListener(eventName, (event) => {
          event.preventDefault();
          dropZone.classList.remove('dragging');
        });
      });

      dropZone.addEventListener('drop', (event) => selectFile(event.dataTransfer?.files?.[0]));

      removeButton.addEventListener('click', () => {
        file = null;
        input.value = '';
        selected.hidden = true;
        processing.hidden = true;
        if (timer) clearInterval(timer);
      });

      processButton.addEventListener('click', () => {
        if (!file) return;
        processing.hidden = false;
        let progress = 0;
        processText.textContent = 'Preparing document…';
        progressBar.style.width = '0%';
        processPercent.textContent = '0%';
        if (timer) clearInterval(timer);
        timer = setInterval(() => {
          progress += 20;
          progressBar.style.width = `${progress}%`;
          processPercent.textContent = `${progress}%`;
          processText.textContent = progress < 100 ? 'Ready for OCR processing…' : 'Document selected — OCR backend pending';
          if (progress >= 100) clearInterval(timer);
        }, 180);
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: #f5f7f8; }
  :global(body) { margin: 0; color: #172026; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  :global(button) { font: inherit; }

  .shell { width: min(1120px, calc(100% - 40px)); margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; }
  .topbar { height: 88px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #dfe5e8; }
  .brand { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; }
  .brand-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 9px; background: #172026; color: white; font-size: 12px; font-weight: 800; letter-spacing: .04em; }
  .brand strong, .brand small { display: block; }
  .brand strong { font-size: 14px; letter-spacing: -.01em; }
  .brand small { margin-top: 2px; color: #758087; font-size: 11px; }
  .status { display: flex; align-items: center; gap: 8px; color: #647077; font-size: 12px; }
  .status i { width: 7px; height: 7px; border-radius: 50%; background: #4b8b65; }

  .hero { padding: 84px 0 48px; max-width: 760px; }
  .eyebrow { margin-bottom: 18px; color: #647077; font-size: 11px; font-weight: 750; letter-spacing: .16em; }
  h1 { margin: 0; font-size: clamp(40px, 6vw, 68px); line-height: .98; letter-spacing: -.055em; font-weight: 760; }
  h1 em { color: #5f6d73; font-style: normal; }
  .hero p { max-width: 570px; margin: 22px 0 0; color: #647077; font-size: 16px; line-height: 1.65; }

  .workspace { display: grid; grid-template-columns: 1.55fr 1fr; gap: 18px; }
  .upload-card, .info-card, .selected, .processing { border: 1px solid #dce3e6; background: rgba(255,255,255,.78); border-radius: 18px; }
  .upload-card { min-height: 370px; padding: 42px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; transition: border-color .2s, background .2s; }
  .upload-card.dragging { border-color: #172026; background: #fff; }
  .upload-icon { width: 46px; height: 46px; display: grid; place-items: center; border: 1px solid #d8e0e3; border-radius: 12px; font-size: 23px; }
  h2 { margin: 25px 0 8px; font-size: 24px; letter-spacing: -.025em; }
  .upload-card p { margin: 0 0 25px; max-width: 450px; color: #758087; line-height: 1.55; font-size: 14px; }
  .primary { border: 0; border-radius: 9px; padding: 12px 17px; background: #172026; color: #fff; cursor: pointer; font-weight: 650; font-size: 13px; }
  .primary:hover { background: #2a363c; }
  .primary.small { padding: 10px 14px; }
  .formats { margin-top: 14px; color: #929ba0; font-size: 11px; letter-spacing: .08em; }

  .info-card { padding: 27px; }
  .card-heading { display: flex; justify-content: space-between; padding-bottom: 21px; border-bottom: 1px solid #e4e9eb; color: #69757b; font-size: 10px; font-weight: 750; letter-spacing: .13em; }
  .phase { color: #a0a8ac; }
  ol { list-style: none; padding: 7px 0 0; margin: 0; }
  li { display: grid; grid-template-columns: 35px 1fr; gap: 10px; padding: 18px 0; color: #899399; border-bottom: 1px solid #edf0f1; }
  li:last-child { border: 0; }
  li b { font-size: 10px; padding-top: 2px; color: #a7afb3; }
  li span { font-size: 13px; font-weight: 650; }
  li small { display: block; margin-top: 4px; color: #9aa3a7; font-size: 11px; font-weight: 400; }
  li.active { color: #172026; }
  li.active b { color: #172026; }

  .selected { margin-top: 18px; padding: 15px; display: flex; align-items: center; gap: 13px; }
  .file-symbol { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; background: #edf1f2; color: #5d696f; font-size: 9px; font-weight: 800; }
  .file-details { flex: 1; min-width: 0; }
  .file-details strong, .file-details span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .file-details strong { font-size: 13px; }
  .file-details span { margin-top: 4px; color: #899399; font-size: 11px; }
  .ghost { border: 0; background: transparent; color: #78848a; cursor: pointer; font-size: 12px; }

  .processing { margin-top: 18px; padding: 22px; }
  .processing-head { display: flex; justify-content: space-between; font-size: 12px; }
  .processing-head strong { font-size: 12px; }
  .progress { height: 5px; margin-top: 13px; overflow: hidden; border-radius: 99px; background: #e8edef; }
  .progress span { display: block; width: 0; height: 100%; background: #172026; transition: width .2s; }
  .processing p { margin: 12px 0 0; color: #8b959a; font-size: 11px; }

  footer { margin-top: auto; padding: 38px 0 24px; display: flex; justify-content: space-between; color: #99a2a6; font-size: 10px; letter-spacing: .03em; }

  @media (max-width: 760px) {
    .shell { width: min(100% - 24px, 600px); }
    .topbar { height: 72px; }
    .status { display: none; }
    .hero { padding: 56px 0 34px; }
    .workspace { grid-template-columns: 1fr; }
    .upload-card { min-height: 320px; padding: 28px; }
    .selected { flex-wrap: wrap; }
    .selected .primary { width: 100%; }
    footer { flex-direction: column; gap: 8px; }
  }
</style>
