---
const title = "PDF → JSON";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <style>
    :root {
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      color: #111827;
      background: #f4f6f8;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background:
        radial-gradient(
          circle at top,
          #ffffff 0,
          #f4f6f8 45%,
          #eef1f4 100%
        );
    }

    .page {
      width: min(1100px, calc(100% - 32px));
      margin: 0 auto;
      padding: 48px 0 80px;
    }

    .header {
      margin-bottom: 28px;
    }

    .eyebrow {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #6b7280;
      margin-bottom: 10px;
    }

    h1 {
      margin: 0;
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1;
      letter-spacing: -0.04em;
    }

    .subtitle {
      margin: 14px 0 0;
      color: #6b7280;
      font-size: 16px;
      max-width: 700px;
      line-height: 1.6;
    }

    .card {
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #e5e7eb;
      border-radius: 22px;
      box-shadow:
        0 20px 60px rgba(15, 23, 42, 0.08),
        0 4px 12px rgba(15, 23, 42, 0.04);
      overflow: hidden;
    }

    .upload-card {
      padding: 28px;
    }

    .drop-zone {
      min-height: 270px;
      border: 2px dashed #cbd5e1;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
      transition:
        border-color 0.2s ease,
        background 0.2s ease,
        transform 0.2s ease;
      cursor: pointer;
    }

    .drop-zone:hover {
      border-color: #94a3b8;
      background: #f8fafc;
    }

    .drop-zone.dragging {
      border-color: #111827;
      background: #f1f5f9;
      transform: scale(1.01);
    }

    .upload-icon {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      background: #111827;
      color: white;
      font-size: 25px;
      margin-bottom: 18px;
    }

    .drop-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .drop-description {
      color: #64748b;
      font-size: 14px;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .button {
      border: 0;
      border-radius: 10px;
      padding: 11px 17px;
      font-size: 14px;
      font-weight: 650;
      cursor: pointer;
      transition:
        transform 0.15s ease,
        opacity 0.15s ease,
        background 0.15s ease;
    }

    .button:hover {
      transform: translateY(-1px);
    }

    .button:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      transform: none;
    }

    .button-primary {
      color: white;
      background: #111827;
    }

    .button-secondary {
      color: #111827;
      background: #e5e7eb;
    }

    .button-ghost {
      color: #374151;
      background: transparent;
      border: 1px solid #d1d5db;
    }

    input[type="file"] {
      display: none;
    }

    .file-info {
      display: none;
      margin-top: 18px;
      padding: 14px 16px;
      border-radius: 12px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
    }

    .file-info.visible {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .file-name {
      font-weight: 650;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .file-size {
      color: #64748b;
      font-size: 12px;
      margin-top: 3px;
    }

    .convert-row {
      display: flex;
      justify-content: flex-end;
      margin-top: 18px;
    }

    .progress-card {
      display: none;
      margin-top: 18px;
      padding: 22px;
      border-top: 1px solid #e5e7eb;
    }

    .progress-card.visible {
      display: block;
    }

    .status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 12px;
    }

    .status {
      font-size: 14px;
      font-weight: 650;
    }

    .percentage {
      font-size: 13px;
      color: #64748b;
    }

    .progress-track {
      width: 100%;
      height: 9px;
      border-radius: 999px;
      background: #e5e7eb;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: #111827;
      border-radius: inherit;
      transition: width 0.2s ease;
    }

    .details {
      margin-top: 10px;
      font-size: 12px;
      color: #64748b;
      line-height: 1.5;
    }

    .result-card {
      display: none;
      margin-top: 20px;
    }

    .result-card.visible {
      display: block;
    }

    .result-header {
      padding: 24px 28px;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: center;
    }

    .result-title {
      margin: 0;
      font-size: 20px;
    }

    .result-meta {
      margin-top: 5px;
      color: #64748b;
      font-size: 13px;
    }

    .result-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .json-preview {
      margin: 0;
      padding: 24px 28px;
      max-height: 520px;
      overflow: auto;
      background: #0f172a;
      color: #e2e8f0;
      font-family:
        "Cascadia Code",
        "SFMono-Regular",
        Consolas,
        monospace;
      font-size: 12px;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .firebase-status {
      padding: 14px 28px;
      border-top: 1px solid #e5e7eb;
      color: #64748b;
      font-size: 12px;
    }

    .error {
      color: #b91c1c;
    }

    .success {
      color: #047857;
    }

    .history-card {
      margin-top: 20px;
      padding: 24px 28px;
    }

    .history-title {
      margin: 0 0 16px;
      font-size: 18px;
    }

    .history-list {
      display: grid;
      gap: 8px;
    }

    .history-empty {
      color: #64748b;
      font-size: 13px;
    }

    .history-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 14px;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      background: #fafafa;
    }

    .history-name {
      font-weight: 600;
      font-size: 14px;
    }

    .history-date {
      color: #64748b;
      font-size: 11px;
      margin-top: 3px;
    }

    .paste-hint {
      margin-top: 12px;
      color: #94a3b8;
      font-size: 12px;
    }

    @media (max-width: 700px) {
      .page {
        width: min(100% - 20px, 1100px);
        padding-top: 24px;
      }

      .upload-card {
        padding: 14px;
      }

      .drop-zone {
        min-height: 240px;
      }

      .result-header {
        flex-direction: column;
        align-items: flex-start;
      }

      .history-item {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <header class="header">
      <div class="eyebrow">Document extraction</div>
      <h1>PDF → JSON</h1>
      <p class="subtitle">
        Extract text and document content from PDFs directly in your browser.
        Scanned, image-based, handwritten and text PDFs are supported.
      </p>
    </header>

    <section class="card upload-card">
      <div
        id="dropZone"
        class="drop-zone"
        tabindex="0"
        role="button"
        aria-label="Choose or drop a PDF"
      >
        <div class="upload-icon">↑</div>

        <div class="drop-title">
          Drop your PDF here
        </div>

        <div class="drop-description">
          Or choose a PDF from your device.
          <br />
          You can also paste a PDF with Ctrl + V.
        </div>

        <label class="button button-secondary">
          Choose PDF
          <input
            id="fileInput"
            type="file"
            accept="application/pdf,.pdf"
          />
        </label>

        <div class="paste-hint">
          PDF files only
        </div>
      </div>

      <div id="fileInfo" class="file-info">
        <div>
          <div id="fileName" class="file-name"></div>
          <div id="fileSize" class="file-size"></div>
        </div>

        <button id="removeFile" class="button button-ghost">
          Remove
        </button>
      </div>

      <div class="convert-row">
        <button
          id="convertButton"
          class="button button-primary"
          disabled
        >
          Convert to JSON
        </button>
      </div>

      <div id="progressCard" class="progress-card">
        <div class="status-row">
          <div id="status" class="status">
            Preparing...
          </div>

          <div id="percentage" class="percentage">
            0%
          </div>
        </div>

        <div class="progress-track">
          <div id="progressBar" class="progress-bar"></div>
        </div>

        <div id="details" class="details">
          Starting document processing...
        </div>
      </div>
    </section>

    <section id="resultCard" class="card result-card">
      <div class="result-header">
        <div>
          <h2 class="result-title">
            Extracted JSON
          </h2>

          <div id="resultMeta" class="result-meta"></div>
        </div>

        <div class="result-actions">
          <button id="downloadButton" class="button button-primary">
            Download JSON
          </button>
        </div>
      </div>

      <pre id="jsonPreview" class="json-preview"></pre>

      <div id="firebaseStatus" class="firebase-status">
        Preparing Firebase...
      </div>
    </section>

    <section class="card history-card">
      <h2 class="history-title">
        Stored JSON
      </h2>

      <div id="historyList" class="history-list">
        <div class="history-empty">
          Loading stored documents...
        </div>
      </div>
    </section>
  </main>

  <script>
    import * as pdfjsLib from "pdfjs-dist";
    import { createWorker } from "tesseract.js";

    import { db } from "../lib/firebase.js";

    import {
      collection,
      deleteDoc,
      doc,
      getDocs,
      setDoc
    } from "firebase/firestore";

    /*
     * ------------------------------------------------------------
     * PDF.JS WORKER
     * ------------------------------------------------------------
     */

    pdfjsLib.GlobalWorkerOptions.workerSrc =
      `${import.meta.env.BASE_URL}pdf.worker.min.mjs`;


    /*
     * ------------------------------------------------------------
     * DOM
     * ------------------------------------------------------------
     */

    const fileInput =
      document.getElementById("fileInput");

    const dropZone =
      document.getElementById("dropZone");

    const fileInfo =
      document.getElementById("fileInfo");

    const fileName =
      document.getElementById("fileName");

    const fileSize =
      document.getElementById("fileSize");

    const removeFile =
      document.getElementById("removeFile");

    const convertButton =
      document.getElementById("convertButton");

    const progressCard =
      document.getElementById("progressCard");

    const progressBar =
      document.getElementById("progressBar");

    const percentage =
      document.getElementById("percentage");

    const status =
      document.getElementById("status");

    const details =
      document.getElementById("details");

    const resultCard =
      document.getElementById("resultCard");

    const resultMeta =
      document.getElementById("resultMeta");

    const jsonPreview =
      document.getElementById("jsonPreview");

    const downloadButton =
      document.getElementById("downloadButton");

    const firebaseStatus =
      document.getElementById("firebaseStatus");

    const historyList =
      document.getElementById("historyList");


    /*
     * ------------------------------------------------------------
     * STATE
     * ------------------------------------------------------------
     */

    let selectedPDF = null;
    let generatedJSON = null;
    let generatedFileName = null;


    /*
     * ------------------------------------------------------------
     * HELPERS
     * ------------------------------------------------------------
     */

    function setProgress(value, message, detail = "") {
      const safeValue =
        Math.max(0, Math.min(100, value));

      progressBar.style.width =
        `${safeValue}%`;

      percentage.textContent =
        `${Math.round(safeValue)}%`;

      status.textContent =
        message;

      details.textContent =
        detail;
    }


    function formatBytes(bytes) {
      if (!bytes) return "0 Bytes";

      const units = [
        "Bytes",
        "KB",
        "MB",
        "GB"
      ];

      const index =
        Math.floor(
          Math.log(bytes) / Math.log(1024)
        );

      return (
        `${(bytes / Math.pow(1024, index)).toFixed(2)} ${units[index]}`
      );
    }


    function getOutputName(name) {
      return (
        name
          .replace(/\.pdf$/i, "")
          .replace(/[^\w\s.-]/g, "_")
          .trim()
        + ".json"
      );
    }


    function escapeHTML(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");
    }


    /*
     * ------------------------------------------------------------
     * FILE SELECTION
     * ------------------------------------------------------------
     */

    function selectPDF(file) {
      if (!file) return;

      const isPDF =
        file.type === "application/pdf" ||
        file.name.toLowerCase().endsWith(".pdf");

      if (!isPDF) {
        alert("Please select a PDF file only.");
        return;
      }

      selectedPDF = file;

      fileName.textContent =
        file.name;

      fileSize.textContent =
        formatBytes(file.size);

      fileInfo.classList.add("visible");

      convertButton.disabled =
        false;

      resultCard.classList.remove(
        "visible"
      );

      progressCard.classList.remove(
        "visible"
      );

      generatedJSON = null;
      generatedFileName = null;
    }


    fileInput.addEventListener(
      "change",
      () => {
        selectPDF(
          fileInput.files?.[0]
        );
      }
    );


    removeFile.addEventListener(
      "click",
      () => {
        selectedPDF = null;

        fileInput.value = "";

        fileInfo.classList.remove(
          "visible"
        );

        convertButton.disabled =
          true;

        resultCard.classList.remove(
          "visible"
        );

        progressCard.classList.remove(
          "visible"
        );
      }
    );


    /*
     * ------------------------------------------------------------
     * DRAG & DROP
     * ------------------------------------------------------------
     */

    dropZone.addEventListener(
      "dragover",
      (event) => {
        event.preventDefault();

        dropZone.classList.add(
          "dragging"
        );
      }
    );


    dropZone.addEventListener(
      "dragleave",
      () => {
        dropZone.classList.remove(
          "dragging"
        );
      }
    );


    dropZone.addEventListener(
      "drop",
      (event) => {
        event.preventDefault();

        dropZone.classList.remove(
          "dragging"
        );

        const file =
          event.dataTransfer?.files?.[0];

        selectPDF(file);
      }
    );


    /*
     * ------------------------------------------------------------
     * PASTE PDF
     * ------------------------------------------------------------
     */

    window.addEventListener(
      "paste",
      (event) => {
        const items =
          [...(event.clipboardData?.items || [])];

        for (const item of items) {
          if (
            item.kind === "file" &&
            item.type === "application/pdf"
          ) {
            const file =
              item.getAsFile();

            if (file) {
              selectPDF(file);
            }

            break;
          }
        }
      }
    );


    /*
     * ------------------------------------------------------------
     * EXTRACT EMBEDDED TEXT
     * ------------------------------------------------------------
     */

    async function extractTextLayer(page) {
      const textContent =
        await page.getTextContent();

      const items =
        textContent.items || [];

      const text =
        items
          .map((item) => item.str || "")
          .join(" ")
          .replace(/\s+/g, " ")
          .trim();

      return text;
    }


    /*
     * ------------------------------------------------------------
     * RENDER PAGE
     * ------------------------------------------------------------
     */

    async function renderPage(page) {
      const baseViewport =
        page.getViewport({
          scale: 1
        });

      /*
       * Use a reasonable browser OCR resolution.
       *
       * 2.5x is roughly equivalent to
       * 180 DPI for normal PDF pages.
       *
       * This avoids enormous canvases on phones.
       */

      const scale = 2.5;

      const viewport =
        page.getViewport({
          scale
        });

      const canvas =
        document.createElement("canvas");

      const context =
        canvas.getContext("2d", {
          willReadFrequently: true
        });

      canvas.width =
        Math.ceil(viewport.width);

      canvas.height =
        Math.ceil(viewport.height);

      await page.render({
        canvasContext: context,
        viewport
      }).promise;

      return {
        canvas,
        viewport,
        baseViewport
      };
    }


    /*
     * ------------------------------------------------------------
     * OCR
     * ------------------------------------------------------------
     */

    async function createOCRWorker() {
      const worker =
        await createWorker(
          "eng",
          1,
          {
            logger: (message) => {
              if (
                message.status ===
                "recognizing text"
              ) {
                const value =
                  Math.max(
                    0,
                    Math.min(
                      1,
                      Number(message.progress || 0)
                    )
                  );

                details.textContent =
                  `OCR ${(value * 100).toFixed(0)}%`;
              }
            }
          }
        );

      return worker;
    }


    async function ocrCanvas(worker, canvas) {
      const result =
        await worker.recognize(canvas);

      return (
        result?.data?.text || ""
      );
    }


    /*
     * ------------------------------------------------------------
     * PAGE OCR
     * ------------------------------------------------------------
     *
     * We intentionally OCR the COMPLETE page.
     *
     * The old Python implementation assumed
     * every document was a two-column question paper.
     *
     * That is no longer acceptable for a generic
     * PDF → JSON converter.
     * ------------------------------------------------------------
     */

    async function extractPageContent(
      page,
      worker
    ) {
      const textLayer =
        await extractTextLayer(page);

      /*
       * If the PDF contains real text,
       * keep that text.
       */

      if (textLayer.length > 20) {
        return {
          extraction_method:
            "text-layer",
          text:
            textLayer,
          ocr_text:
            null
        };
      }


      /*
       * Otherwise render the page and OCR it.
       */

      const rendered =
        await renderPage(page);

      const ocrText =
        await ocrCanvas(
          worker,
          rendered.canvas
        );

      return {
        extraction_method:
          "ocr",
        text:
          ocrText.trim(),
        ocr_text:
          ocrText.trim()
      };
    }


    /*
     * ------------------------------------------------------------
     * OPTIONAL IMAGE INFORMATION
     * ------------------------------------------------------------
     */

    function detectPageCharacteristics(
      text
    ) {
      const clean =
        String(text || "").trim();

      return {
        has_text:
          clean.length > 0,

        character_count:
          clean.length,

        word_count:
          clean
            ? clean.split(/\s+/).length
            : 0,

        likely_handwritten:
          false,

        likely_table:
          /table|total|amount|date|description/i.test(
            clean
          ),

        likely_question_bank:
          /(^|\n)\s*\d{1,3}[.)]\s+/m.test(
            clean
          )
      };
    }


    /*
     * ------------------------------------------------------------
     * BUILD GENERIC JSON
     * ------------------------------------------------------------
     */

    async function convertPDF(file) {
      const arrayBuffer =
        await file.arrayBuffer();

      const pdf =
        await pdfjsLib
          .getDocument({
            data: arrayBuffer
          })
          .promise;

      const totalPages =
        pdf.numPages;

      const pages = [];

      let worker = null;

      try {
        worker =
          await createOCRWorker();

        for (
          let pageNumber = 1;
          pageNumber <= totalPages;
          pageNumber++
        ) {
          setProgress(
            ((pageNumber - 1) /
              totalPages) *
              100,
            `Processing page ${pageNumber} of ${totalPages}`,
            "Reading document..."
          );

          const page =
            await pdf.getPage(
              pageNumber
            );

          const pageResult =
            await extractPageContent(
              page,
              worker
            );

          const characteristics =
            detectPageCharacteristics(
              pageResult.text
            );

          pages.push({
            page_number:
              pageNumber,

            extraction_method:
              pageResult.extraction_method,

            text:
              pageResult.text,

            characteristics
          });

          setProgress(
            (pageNumber /
              totalPages) *
              100,
            `Processed page ${pageNumber} of ${totalPages}`,
            `${pages.reduce(
              (total, page) =>
                total +
                page.characteristics.character_count,
              0
            )} characters extracted`
          );
        }
      } finally {
        if (worker) {
          await worker.terminate();
        }
      }


      /*
       * Complete document text.
       */

      const fullText =
        pages
          .map(
            (page) =>
              `--- Page ${page.page_number} ---\n${page.text}`
          )
          .join("\n\n");


      /*
       * Generic JSON schema.
       */

      return {
        schema_version:
          "1.0",

        document: {
          file_name:
            file.name,

          output_file:
            getOutputName(
              file.name
            ),

          mime_type:
            file.type ||
            "application/pdf",

          file_size_bytes:
            file.size,

          page_count:
            totalPages,

          extraction_engine:
            "PDF.js + Tesseract.js",

          extraction_mode:
            "browser"
        },

        pages,

        text:
          fullText,

        statistics: {
          pages:
            totalPages,

          characters:
            fullText.length,

          words:
            fullText
              ? fullText.split(/\s+/).length
              : 0,

          pages_with_text:
            pages.filter(
              (page) =>
                page.text.length > 0
            ).length,

          pages_without_text:
            pages.filter(
              (page) =>
                page.text.length === 0
            ).length
        }
      };
    }


    /*
     * ------------------------------------------------------------
     * DOWNLOAD
     * ------------------------------------------------------------
     */

    function downloadJSON() {
      if (!generatedJSON) {
        return;
      }

      const jsonText =
        JSON.stringify(
          generatedJSON,
          null,
          2
        );

      const blob =
        new Blob(
          [jsonText],
          {
            type:
              "application/json;charset=utf-8"
          }
        );

      const url =
        URL.createObjectURL(
          blob
        );

      const link =
        document.createElement("a");

      link.href =
        url;

      link.download =
        generatedFileName ||
        "document.json";

      document.body.appendChild(
        link
      );

      link.click();

      link.remove();

      URL.revokeObjectURL(
        url
      );
    }


    downloadButton.addEventListener(
      "click",
      downloadJSON
    );


    /*
     * ------------------------------------------------------------
     * FIREBASE
     * ------------------------------------------------------------
     *
     * Firebase saving is AUTOMATIC.
     *
     * There is deliberately NO
     * "Save to Firebase" button.
     * ------------------------------------------------------------
     */

    async function saveToFirebase(
      jsonData,
      outputName
    ) {
      firebaseStatus.textContent =
        "Saving JSON to Firebase...";

      firebaseStatus.className =
        "firebase-status";

      const documentId =
        outputName
          .replace(/[\/\\#?]/g, "_");

      await setDoc(
        doc(
          db,
          "questionBanks",
          documentId
        ),
        {
          fileName:
            outputName,

          sourcePDF:
            jsonData.document.file_name,

          pageCount:
            jsonData.document.page_count,

          characterCount:
            jsonData.statistics.characters,

          data:
            jsonData,

          updatedAt:
            new Date().toISOString()
        }
      );

      firebaseStatus.textContent =
        "Automatically saved to Firebase.";

      firebaseStatus.className =
        "firebase-status success";
    }


    /*
     * ------------------------------------------------------------
     * LOAD FIREBASE HISTORY
     * ------------------------------------------------------------
     */

    async function loadHistory() {
      try {
        const snapshot =
          await getDocs(
            collection(
              db,
              "questionBanks"
            )
          );

        if (
          snapshot.empty
        ) {
          historyList.innerHTML =
            `<div class="history-empty">
              No stored JSON documents yet.
            </div>`;

          return;
        }

        const documents =
          snapshot.docs
            .map(
              (item) => ({
                id:
                  item.id,
                ...item.data()
              })
            )
            .sort(
              (a, b) =>
                String(
                  b.updatedAt || ""
                ).localeCompare(
                  String(
                    a.updatedAt || ""
                  )
                )
            );

        historyList.innerHTML =
          documents
            .map(
              (item) => `
                <div
                  class="history-item"
                  data-id="${escapeHTML(item.id)}"
                >
                  <div>
                    <div class="history-name">
                      ${escapeHTML(
                        item.fileName ||
                        item.id
                      )}
                    </div>

                    <div class="history-date">
                      ${escapeHTML(
                        item.updatedAt ||
                        ""
                      )}
                    </div>
                  </div>

                  <button
                    class="button button-ghost open-history"
                    data-id="${escapeHTML(item.id)}"
                  >
                    Open
                  </button>

                  <button
                    class="button button-ghost delete-history"
                    data-id="${escapeHTML(item.id)}"
                  >
                    Delete
                  </button>
                </div>
              `
            )
            .join("");


        historyList
          .querySelectorAll(
            ".open-history"
          )
          .forEach(
            (button) => {
              button.addEventListener(
                "click",
                () =>
                  openStoredDocument(
                    button.dataset.id
                  )
              );
            }
          );


        historyList
          .querySelectorAll(
            ".delete-history"
          )
          .forEach(
            (button) => {
              button.addEventListener(
                "click",
                () =>
                  deleteStoredDocument(
                    button.dataset.id
                  )
              );
            }
          );
      } catch (error) {
        historyList.innerHTML =
          `<div class="history-empty error">
            Firebase history unavailable.
          </div>`;

        console.error(
          "Firebase history error:",
          error
        );
      }
    }


    /*
     * ------------------------------------------------------------
     * OPEN STORED JSON
     * ------------------------------------------------------------
     */

    async function openStoredDocument(
      id
    ) {
      try {
        const snapshot =
          await getDocs(
            collection(
              db,
              "questionBanks"
            )
          );

        const item =
          snapshot.docs.find(
            (docItem) =>
              docItem.id === id
          );

        if (!item) {
          return;
        }

        const data =
          item.data();

        generatedJSON =
          data.data;

        generatedFileName =
          data.fileName ||
          `${id}.json`;

        jsonPreview.textContent =
          JSON.stringify(
            generatedJSON,
            null,
            2
          );

        resultMeta.textContent =
          `${generatedJSON.document.page_count} page(s) • ${generatedJSON.statistics.characters} characters`;

        resultCard.classList.add(
          "visible"
        );

        window.scrollTo({
          top:
            resultCard.offsetTop -
            20,
          behavior:
            "smooth"
        });
      } catch (error) {
        console.error(
          error
        );

        alert(
          "Unable to open stored JSON."
        );
      }
    }


    /*
     * ------------------------------------------------------------
     * DELETE STORED JSON
     * ------------------------------------------------------------
     */

    async function deleteStoredDocument(
      id
    ) {
      const confirmed =
        confirm(
          "Delete this stored JSON?"
        );

      if (!confirmed) {
        return;
      }

      try {
        await deleteDoc(
          doc(
            db,
            "questionBanks",
            id
          )
        );

        await loadHistory();
      } catch (error) {
        console.error(
          error
        );

        alert(
          "Unable to delete stored JSON."
        );
      }
    }


    /*
     * ------------------------------------------------------------
     * CONVERT BUTTON
     * ------------------------------------------------------------
     */

    convertButton.addEventListener(
      "click",
      async () => {
        if (!selectedPDF) {
          return;
        }

        convertButton.disabled =
          true;

        removeFile.disabled =
          true;

        progressCard.classList.add(
          "visible"
        );

        resultCard.classList.remove(
          "visible"
        );

        setProgress(
          0,
          "Opening PDF...",
          "Loading document..."
        );

        try {
          generatedJSON =
            await convertPDF(
              selectedPDF
            );

          generatedFileName =
            getOutputName(
              selectedPDF.name
            );

          const jsonText =
            JSON.stringify(
              generatedJSON,
              null,
              2
            );

          jsonPreview.textContent =
            jsonText;

          resultMeta.textContent =
            `${generatedJSON.document.page_count} page(s) • ${generatedJSON.statistics.characters} characters extracted`;

          resultCard.classList.add(
            "visible"
          );

          setProgress(
            100,
            "Conversion complete",
            `${generatedJSON.statistics.characters} characters extracted from ${generatedJSON.document.page_count} page(s).`
          );


          /*
           * Automatically save.
           */

          try {
            await saveToFirebase(
              generatedJSON,
              generatedFileName
            );

            await loadHistory();
          } catch (firebaseError) {
            console.error(
              "Firebase save error:",
              firebaseError
            );

            firebaseStatus.textContent =
              "JSON created successfully, but Firebase save failed.";

            firebaseStatus.className =
              "firebase-status error";
          }
        } catch (error) {
          console.error(
            "PDF conversion error:",
            error
          );

          setProgress(
            0,
            "Conversion failed",
            error?.message ||
              String(error)
          );

          status.classList.add(
            "error"
          );
        } finally {
          convertButton.disabled =
            false;

          removeFile.disabled =
            false;
        }
      }
    );


    /*
     * ------------------------------------------------------------
     * INITIAL FIREBASE LOAD
     * ------------------------------------------------------------
     */

    loadHistory();
  </script>
</body>
</html>